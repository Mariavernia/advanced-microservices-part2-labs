# Course connection settings.
#
# This file intentionally contains NO passwords, tokens, kubeconfigs or client secrets.
# Azure/AKS identifiers for the currently configured lab environment.
# Instructors configure these values and the image references for each deployment.
# Keeping these values in the repository is acceptable because they are identifiers,
# not credentials.

AZURE_TENANT_ID="2baaa038-6c97-4397-8a59-4a424c9c15c3"
AZURE_SUBSCRIPTION_ID="4366001b-bee8-411b-bedb-d4fb856cc75d"
AKS_RESOURCE_GROUP="rg-advms26-course"
AKS_NAME="aks-advms26-course"

# Optional shared-platform endpoints used by: ./scripts/preflight.sh --full
GRAFANA_URL=""
JAEGER_URL=""
KIBANA_URL=""
KEYCLOAK_URL=""
ACR_LOGIN_SERVER="advms26acr4366001b.azurecr.io"

# P05 OIDC provider details (identifiers only; no passwords or client secrets)
# The public HTTPS issuer must match the realm's discovery document.
# The instructor provisions the application accounts and verifies the endpoints.
OIDC_ISSUER_URI="https://auth.microservices.training.cloudsecurityinpractice.com/realms/advanced-orders"
OIDC_AUDIENCE="advanced-orders-api"
OIDC_CLIENT_ID="advanced-orders-cli"
